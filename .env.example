# Base URL of the portfolio API. Defaults to https://api.figueroa-sanchez.com;
# point it to your local API (e.g. http://localhost:<api-port>) for development.
API_URL=https://api.figueroa-sanchez.com
# Public OAuth web client ID from Google Cloud (not a secret).
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
